/*
  X-Content-Type-Options: nosniff
# scripts and styles change with every deploy: make browsers check the ETag each load instead of keeping a
# 5-minute-old copy (a stale file next to a fresh index.html shows the old UI)
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
# versioned in the file name, so it never changes
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
